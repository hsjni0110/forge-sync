#!/bin/sh
set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
database_compose="$repository_root/infra/database/compose.yaml"
mqtt_compose="$repository_root/infra/mqtt/compose.yaml"
database_port=${FORGESYNC_DATABASE_PORT:-15432}
mqtt_port=${FORGESYNC_MQTT_PORT:-18883}
api_port=${FORGESYNC_API_PORT:-8080}
web_port=${FORGESYNC_WEB_PORT:-5173}
replay_api_port=${FORGESYNC_REPLAY_API_PORT:-8002}
database_project="forgesync-local-database-$$"
mqtt_project="forgesync-local-mqtt-$$"
api_mqtt_client_id="forgesync-api-local-$$"
runtime_directory=$(mktemp -d "${TMPDIR:-/tmp}/forgesync-local.XXXXXX")
api_pid=""
web_pid=""
replay_api_pid=""

run_database_compose() {
  FORGESYNC_DATABASE_PORT="$database_port" \
    docker compose --project-name "$database_project" --file "$database_compose" "$@"
}

run_mqtt_compose() {
  FORGESYNC_MQTT_PORT="$mqtt_port" \
    docker compose --project-name "$mqtt_project" --file "$mqtt_compose" "$@"
}

cleanup() {
  exit_code=$?
  trap - EXIT INT TERM
  printf '\nForgeSync local runtime을 종료합니다.\n'
  if [ -n "$replay_api_pid" ]; then kill "$replay_api_pid" 2>/dev/null || true; fi
  if [ -n "$web_pid" ]; then kill "$web_pid" 2>/dev/null || true; fi
  if [ -n "$api_pid" ]; then kill "$api_pid" 2>/dev/null || true; fi
  if [ -n "$replay_api_pid" ]; then wait "$replay_api_pid" 2>/dev/null || true; fi
  if [ -n "$web_pid" ]; then wait "$web_pid" 2>/dev/null || true; fi
  if [ -n "$api_pid" ]; then wait "$api_pid" 2>/dev/null || true; fi
  run_mqtt_compose down --volumes || true
  run_database_compose down --volumes || true
  rm -rf "$repository_root/apps/factory-api/$api_mqtt_client_id"
  rm -rf "$runtime_directory"
  exit "$exit_code"
}
trap cleanup EXIT INT TERM

wait_for_url() {
  url=$1
  log_file=$2
  process_name=$3
  attempts=0
  until curl --fail --silent --show-error "$url" >/dev/null 2>&1; do
    attempts=$((attempts + 1))
    if [ "$attempts" -ge 90 ]; then
      printf '%s 시작을 기다리다 실패했습니다. 최근 로그:\n' "$process_name" >&2
      tail -n 100 "$log_file" >&2
      return 1
    fi
    sleep 1
  done
}

if [ "${1:-}" = "--help" ]; then
  cat <<'EOF'
Usage: ./scripts/run-local

PostgreSQL, Mosquitto, Replay Edge API, Factory API, Factory Web을 실행합니다. 화면의 Replay
시작 버튼으로 checksum이 고정된 Mazak01 데이터를 제어할 수 있습니다.
종료하려면 Ctrl+C를 누르세요.
EOF
  trap - EXIT INT TERM
  rm -rf "$runtime_directory"
  exit 0
fi

if [ "$#" -ne 0 ]; then
  printf '지원하지 않는 인자입니다. 사용법: ./scripts/run-local\n' >&2
  exit 2
fi

printf 'PostgreSQL과 MQTT를 시작합니다...\n'
run_database_compose up --detach --wait
run_mqtt_compose up --detach --wait

printf 'Factory API와 Factory Web을 시작합니다...\n'
canonical_run="$repository_root/datasets/canonical/nist-mazak01-20161005/80ce6b099c6ee90c11dc04286030b7a2448108d7ef9f81152fb3f0e98a06b3ef"
FORGESYNC_REPOSITORY_ROOT="$repository_root" \
FORGESYNC_REPLAY_SOURCE_PATH="$canonical_run" \
FORGESYNC_REPLAY_SOURCE_SET_ID="nist-mazak01-20161005" \
FORGESYNC_MQTT_HOST=localhost \
FORGESYNC_MQTT_PORT="$mqtt_port" \
FORGESYNC_REPLAY_API_PORT="$replay_api_port" \
  uv run --package forgesync-edge-gateway forgesync-replay-api \
  >"$runtime_directory/replay-api.log" 2>&1 &
replay_api_pid=$!
wait_for_url "http://localhost:$replay_api_port/health" "$runtime_directory/replay-api.log" "Replay Edge API"

FORGESYNC_DATABASE_URL="jdbc:postgresql://localhost:$database_port/forgesync" \
FORGESYNC_DATABASE_USERNAME=forgesync \
FORGESYNC_DATABASE_PASSWORD=forgesync-test \
FORGESYNC_MQTT_ENABLED=true \
FORGESYNC_MQTT_SERVER_URI="tcp://localhost:$mqtt_port" \
FORGESYNC_MQTT_CLIENT_ID="$api_mqtt_client_id" \
FORGESYNC_WEBSOCKET_ALLOWED_ORIGINS="http://localhost:$web_port" \
FORGESYNC_REPLAY_EDGE_BASE_URL="http://127.0.0.1:$replay_api_port" \
SERVER_PORT="$api_port" \
  "$repository_root/apps/factory-api/gradlew" -p "$repository_root/apps/factory-api" bootRun \
  >"$runtime_directory/api.log" 2>&1 &
api_pid=$!

VITE_API_BASE_URL="http://localhost:$api_port" \
  npm --prefix "$repository_root/apps/factory-web" run dev -- --host localhost --port "$web_port" \
  >"$runtime_directory/web.log" 2>&1 &
web_pid=$!

wait_for_url "http://localhost:$api_port/actuator/health" "$runtime_directory/api.log" "Factory API"
wait_for_url "http://localhost:$web_port" "$runtime_directory/web.log" "Factory Web"

printf '\nForgeSync가 실행 중입니다.\n'
printf '화면: http://localhost:%s/factory\n' "$web_port"
printf '종료: Ctrl+C\n'
printf '\nREPLAY 배지를 누르고 재생을 시작하면 고정된 NIST 원본 시간을 보존한 채\n'
printf '1x, 10x, 100x 배속과 일시정지, 타임라인 이동을 사용할 수 있습니다.\n\n'

while kill -0 "$api_pid" 2>/dev/null && kill -0 "$web_pid" 2>/dev/null; do
  sleep 1
done

printf 'Factory API 또는 Factory Web이 예기치 않게 종료되었습니다.\n' >&2
printf '\nFactory API 최근 로그:\n' >&2
tail -n 50 "$runtime_directory/api.log" >&2
printf '\nFactory Web 최근 로그:\n' >&2
tail -n 50 "$runtime_directory/web.log" >&2
exit 1
