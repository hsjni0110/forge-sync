{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgesync.local/contracts/websocket/v1/twin-patch.schema.json",
  "title": "ForgeSync Twin Patch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "type",
    "machineId",
    "baseVersion",
    "targetVersion",
    "projectedAt",
    "snapshot"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "type": { "const": "TWIN_PATCH" },
    "machineId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
    "baseVersion": { "type": "integer", "minimum": 0 },
    "targetVersion": { "type": "integer", "minimum": 1 },
    "projectedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "snapshot": {
      "$ref": "https://forgesync.local/contracts/twin/v1/twin-snapshot.schema.json"
    }
  }
}
