{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgesync.dev/contracts/factory-assets/v1/factory-asset-manifest.schema.json",
  "title": "ForgeSync Factory Asset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assets"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression", "evidenceState", "attribution"],
      "properties": {
        "expression": { "type": "string", "minLength": 1 },
        "evidenceState": {
          "enum": ["VERIFIED", "TO_VERIFY", "BLOCKED", "NOT_APPLICABLE"]
        },
        "attribution": { "type": "string", "minLength": 1 },
        "licenseUri": { "type": "string", "format": "uri-reference" }
      }
    },
    "common": {
      "type": "object",
      "required": ["assetId", "displayName", "representation", "origin", "license"],
      "properties": {
        "assetId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "displayName": { "type": "string", "minLength": 1 },
        "representation": { "enum": ["PROCEDURAL", "GLB"] },
        "origin": { "enum": ["PROJECT_PROCEDURAL", "THIRD_PARTY"] },
        "license": { "$ref": "#/$defs/license" }
      }
    },
    "asset": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/common" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["assetId", "displayName", "representation", "origin", "license", "sourceLocator"],
              "properties": {
                "assetId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
                "displayName": { "type": "string", "minLength": 1 },
                "representation": { "const": "PROCEDURAL" },
                "origin": { "const": "PROJECT_PROCEDURAL" },
                "sourceLocator": { "type": "string", "minLength": 1 },
                "license": { "$ref": "#/$defs/license" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/common" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["assetId", "displayName", "representation", "origin", "license", "uri", "sha256", "byteLength"],
              "properties": {
                "assetId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
                "displayName": { "type": "string", "minLength": 1 },
                "representation": { "const": "GLB" },
                "origin": { "const": "THIRD_PARTY" },
                "uri": { "type": "string", "format": "uri-reference" },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "byteLength": { "type": "integer", "minimum": 1 },
                "license": { "$ref": "#/$defs/license" }
              }
            }
          ]
        }
      ]
    }
  }
}
