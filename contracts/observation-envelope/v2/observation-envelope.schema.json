{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgesync.local/contracts/observation-envelope/v2/observation-envelope.schema.json",
  "title": "ForgeSync ObservationEnvelope v2",
  "description": "Canonical NIST observation contract preserving category, source time, replay identity, and provenance.",
  "oneOf": [
    {
      "$ref": "#/$defs/sampleEnvelope"
    },
    {
      "$ref": "#/$defs/eventEnvelope"
    },
    {
      "$ref": "#/$defs/conditionEnvelope"
    }
  ],
  "$defs": {
    "baseEnvelopeProperties": {
      "schemaVersion": {
        "const": "2.0.0"
      },
      "eventId": {
        "type": "string",
        "format": "uuid"
      },
      "sourceEventKey": {
        "type": "string",
        "minLength": 1
      },
      "machineId": {
        "type": "string",
        "minLength": 1
      },
      "subject": {
        "$ref": "#/$defs/subject"
      },
      "source": {
        "$ref": "#/$defs/source"
      },
      "replay": {
        "$ref": "#/$defs/replay"
      },
      "provenance": {
        "$ref": "#/$defs/provenance"
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentId"
      ],
      "properties": {
        "componentId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceObservedAt"
      ],
      "properties": {
        "sourceObservedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "agentInstanceId": {
          "type": "string",
          "minLength": 1
        },
        "sourceSequence": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replaySessionId",
        "replaySequence",
        "replayPublishedAt"
      ],
      "properties": {
        "replaySessionId": {
          "type": "string",
          "format": "uuid"
        },
        "replaySequence": {
          "type": "integer",
          "minimum": 0
        },
        "replayPublishedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "transformation"
      ],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "provider",
            "sourceSetId",
            "artifactId"
          ],
          "properties": {
            "kind": {
              "const": "REAL"
            },
            "provider": {
              "const": "NIST"
            },
            "sourceSetId": {
              "type": "string",
              "minLength": 1
            },
            "artifactId": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "transformation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rawRecordId",
            "mappingVersion",
            "sourceDataItemId"
          ],
          "properties": {
            "rawRecordId": {
              "type": "string",
              "minLength": 1
            },
            "mappingVersion": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "sourceDataItemId": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "samplePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "availability"
      ],
      "properties": {
        "metric": {
          "enum": [
            "ANGLE",
            "SPINDLE_SPEED",
            "PATH_FEEDRATE",
            "TEMPERATURE",
            "LOAD",
            "POSITION"
          ]
        },
        "availability": {
          "enum": [
            "AVAILABLE",
            "UNAVAILABLE"
          ]
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "enum": [
            "DEGREE",
            "REVOLUTION/MINUTE",
            "MILLIMETER/SECOND",
            "CELSIUS",
            "PERCENT",
            "MILLIMETER"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "metric": {
                "const": "ANGLE"
              }
            }
          },
          "then": {
            "properties": {
              "unit": {
                "const": "DEGREE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "availability": {
                "const": "AVAILABLE"
              }
            }
          },
          "then": {
            "required": [
              "value",
              "unit"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "value"
                  ]
                },
                {
                  "required": [
                    "unit"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "SPINDLE_SPEED"
              }
            }
          },
          "then": {
            "properties": {
              "unit": {
                "const": "REVOLUTION/MINUTE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "PATH_FEEDRATE"
              }
            }
          },
          "then": {
            "properties": {
              "unit": {
                "const": "MILLIMETER/SECOND"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "TEMPERATURE"
              }
            }
          },
          "then": {
            "properties": {
              "unit": {
                "const": "CELSIUS"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "LOAD"
              }
            }
          },
          "then": {
            "properties": {
              "unit": {
                "const": "PERCENT"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "POSITION"
              }
            }
          },
          "then": {
            "properties": {
              "unit": {
                "const": "MILLIMETER"
              }
            }
          }
        }
      ]
    },
    "eventPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventType",
        "availability"
      ],
      "properties": {
        "eventType": {
          "enum": [
            "EXECUTION",
            "CONTROLLER_MODE",
            "TOOL_NUMBER",
            "PROGRAM",
            "PART_COUNT",
            "AVAILABILITY",
            "POWER_STATE"
          ]
        },
        "availability": {
          "enum": [
            "AVAILABLE",
            "UNAVAILABLE"
          ]
        },
        "value": {
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "const": "AVAILABLE"
              }
            }
          },
          "then": {
            "required": [
              "value"
            ]
          },
          "else": {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "eventType": {
                "enum": [
                  "TOOL_NUMBER",
                  "PART_COUNT"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "conditionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conditionType",
        "level"
      ],
      "properties": {
        "conditionType": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_:]*$"
        },
        "level": {
          "enum": [
            "NORMAL",
            "WARNING",
            "FAULT",
            "UNAVAILABLE"
          ]
        },
        "nativeCode": {
          "type": "string"
        },
        "nativeSeverity": {
          "type": "string"
        },
        "qualifier": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "sampleEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "sourceEventKey",
        "machineId",
        "subject",
        "observationKind",
        "source",
        "provenance",
        "payload"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/baseEnvelopeProperties/schemaVersion"
        },
        "eventId": {
          "$ref": "#/$defs/baseEnvelopeProperties/eventId"
        },
        "sourceEventKey": {
          "$ref": "#/$defs/baseEnvelopeProperties/sourceEventKey"
        },
        "machineId": {
          "$ref": "#/$defs/baseEnvelopeProperties/machineId"
        },
        "subject": {
          "$ref": "#/$defs/baseEnvelopeProperties/subject"
        },
        "observationKind": {
          "const": "SAMPLE"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "replay": {
          "$ref": "#/$defs/replay"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "payload": {
          "$ref": "#/$defs/samplePayload"
        }
      }
    },
    "eventEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "sourceEventKey",
        "machineId",
        "subject",
        "observationKind",
        "source",
        "provenance",
        "payload"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/baseEnvelopeProperties/schemaVersion"
        },
        "eventId": {
          "$ref": "#/$defs/baseEnvelopeProperties/eventId"
        },
        "sourceEventKey": {
          "$ref": "#/$defs/baseEnvelopeProperties/sourceEventKey"
        },
        "machineId": {
          "$ref": "#/$defs/baseEnvelopeProperties/machineId"
        },
        "subject": {
          "$ref": "#/$defs/baseEnvelopeProperties/subject"
        },
        "observationKind": {
          "const": "EVENT"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "replay": {
          "$ref": "#/$defs/replay"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "payload": {
          "$ref": "#/$defs/eventPayload"
        }
      }
    },
    "conditionEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "sourceEventKey",
        "machineId",
        "subject",
        "observationKind",
        "source",
        "provenance",
        "payload"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/baseEnvelopeProperties/schemaVersion"
        },
        "eventId": {
          "$ref": "#/$defs/baseEnvelopeProperties/eventId"
        },
        "sourceEventKey": {
          "$ref": "#/$defs/baseEnvelopeProperties/sourceEventKey"
        },
        "machineId": {
          "$ref": "#/$defs/baseEnvelopeProperties/machineId"
        },
        "subject": {
          "$ref": "#/$defs/baseEnvelopeProperties/subject"
        },
        "observationKind": {
          "const": "CONDITION"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "replay": {
          "$ref": "#/$defs/replay"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "payload": {
          "$ref": "#/$defs/conditionPayload"
        }
      }
    }
  }
}
