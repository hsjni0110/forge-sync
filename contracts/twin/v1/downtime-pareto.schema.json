{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgesync.local/contracts/twin/v1/downtime-pareto.schema.json",
  "title": "ForgeSync Downtime Pareto v1",
  "description": "Ranked observed downtime intervals. Evidence is temporal correlation and never asserts causation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "processingRunId", "machineId", "replaySessionId",
    "throughReplaySequence", "ruleVersion", "utilizationProcessingRunId",
    "intervalProcessingRunId", "observedFrom", "observedTo",
    "totalDowntimeSeconds", "inputHash", "resultHash", "createdAt", "entries"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "processingRunId": { "$ref": "#/$defs/sha256" },
    "machineId": { "type": "string", "minLength": 1 },
    "replaySessionId": { "type": "string", "format": "uuid" },
    "throughReplaySequence": { "type": "integer", "minimum": 0 },
    "ruleVersion": { "const": "1.0.0" },
    "utilizationProcessingRunId": { "$ref": "#/$defs/sha256" },
    "intervalProcessingRunId": { "$ref": "#/$defs/sha256" },
    "observedFrom": { "$ref": "#/$defs/instant" },
    "observedTo": { "$ref": "#/$defs/instant" },
    "totalDowntimeSeconds": { "type": "number", "minimum": 0 },
    "inputHash": { "$ref": "#/$defs/sha256" },
    "resultHash": { "$ref": "#/$defs/sha256" },
    "createdAt": { "$ref": "#/$defs/instant" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rank", "state", "startedAt", "endedAt", "durationSeconds",
          "ratioPercent", "cumulativeRatioPercent", "startEvidence", "endEvidence",
          "reasonClassification", "evidence"
        ],
        "properties": {
          "rank": { "type": "integer", "minimum": 1 },
          "state": { "enum": ["STOPPED", "INTERRUPTED", "UNKNOWN"] },
          "startedAt": { "$ref": "#/$defs/instant" },
          "endedAt": { "$ref": "#/$defs/instant" },
          "durationSeconds": { "type": "number", "minimum": 0 },
          "ratioPercent": { "type": "number", "minimum": 0, "maximum": 100 },
          "cumulativeRatioPercent": { "type": "number", "minimum": 0, "maximum": 100 },
          "startEvidence": { "$ref": "#/$defs/boundaryEvidence" },
          "endEvidence": { "$ref": "#/$defs/boundaryEvidence" },
          "reasonClassification": { "enum": ["CONCURRENT_EVIDENCE", "UNCONFIRMED_REASON"] },
          "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "instant": {
      "type": "string", "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "boundaryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replaySequence", "sourceObservedAt", "sourceEventKey"],
      "properties": {
        "replaySequence": { "type": "integer", "minimum": 0 },
        "sourceObservedAt": { "$ref": "#/$defs/instant" },
        "sourceEventKey": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "signal", "value", "sourceObservedAt", "replaySequence", "sourceEventKey"],
      "properties": {
        "kind": { "enum": ["ESTOP_OVERLAP", "MODE_CHANGE", "CONDITION_OBSERVATION"] },
        "signal": { "enum": ["EMERGENCY_STOP", "CONTROLLER_MODE", "CONDITION"] },
        "value": { "type": "string", "minLength": 1 },
        "sourceObservedAt": { "$ref": "#/$defs/instant" },
        "replaySequence": { "type": "integer", "minimum": 0 },
        "sourceEventKey": { "type": "string", "minLength": 1 },
        "componentId": { "type": "string", "minLength": 1 },
        "conditionType": { "type": "string", "minLength": 1 },
        "level": { "enum": ["WARNING", "FAULT"] },
        "nativeCode": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
