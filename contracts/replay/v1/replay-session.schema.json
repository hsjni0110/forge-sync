{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgesync.local/contracts/replay/v1/replay-session.schema.json",
  "title": "ForgeSync Replay Session v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "replaySessionId", "machineId", "sourceSetId", "status",
    "speedMultiplier", "revision", "sourceRange"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "replaySessionId": { "type": "string", "format": "uuid" },
    "machineId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
    "sourceSetId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "status": {
      "enum": ["PREPARING", "RUNNING", "PAUSED", "SEEKING", "COMPLETED", "FAILED"]
    },
    "speedMultiplier": { "enum": [1, 10, 100] },
    "revision": { "type": "integer", "minimum": 0 },
    "sourceRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startsAt", "endsAt"],
      "properties": {
        "startsAt": { "$ref": "#/$defs/timestamp" },
        "endsAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "publicationCursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replaySequence", "sourceObservedAt", "replayPublishedAt"],
      "properties": {
        "replaySequence": { "type": "integer", "minimum": 0 },
        "sourceObservedAt": { "$ref": "#/$defs/timestamp" },
        "replayPublishedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "FAILED" } } },
      "then": { "properties": { "failure": true }, "required": ["failure"] },
      "else": { "not": { "required": ["failure"] } }
    }
  ],
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
